{
  "name": "csv2md",
  "version": "1.1.0",
  "description": "csv2md transforms csv data to markdown tables",
  "main": "dist/csv2md.js",
  "bin": {
    "csv2md": "bin/csv2md"
  },
  "scripts": {
    "test": "npm run build && npm run typecheck && mocha",
    "build": "tsc --project tsconfig.json",
    "watch": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tsconfig.test.json",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/pstaender/csv2md.git"
  },
  "homepage": "https://github.com/pstaender/csv2md",
  "bugs": "https://github.com/pstaender/csv2md/issues",
  "keywords": [
    "csv",
    "markdown",
    "table",
    "converter"
  ],
  "author": "Philipp Staender <pstaender@mailbox.org>",
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "stream-transform": "^3.6.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/yargs": "^17.0.35",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "types": "dist/csv2md.d.ts",
  "exports": {
    ".": {
      "types": "./dist/csv2md.d.ts",
      "default": "./dist/csv2md.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "bin"
  ],
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
